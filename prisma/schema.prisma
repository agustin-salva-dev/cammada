generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id         String             @id @default(uuid())
  email      String             @unique
  password   String?
  nombre     String
  telefono   String?
  imagen     String?
  rol        String             @default("AYUDANTE")
  rolConfig  RolConfig          @relation(fields: [rol], references: [nombre])
  cuentas    Cuenta[]
  respuestas RespuestaOficial[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model Cuenta {
  id                String  @id @default(uuid())
  usuarioId         String
  usuario           Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  proveedor         String
  proveedorCuentaId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?

  @@unique([proveedor, proveedorCuentaId])
}

model RolConfig {
  id        String   @id @default(uuid())
  nombre    String   @unique
  permisos  String[]
  isSystem  Boolean   @default(false)
  usuarios  Usuario[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Equipo {
  id         String     @id @default(uuid())
  nombre     String     @unique
  pais       String     @default("Desconocido")
  ciudad     String     @default("Desconocida")
  luchadores Luchador[]
  createdAt  DateTime   @default(now())
}

model CategoriaPeso {
  id              String      @id @default(uuid())
  nombre          String      @unique
  orden           Int         @default(0)
  limiteInferior  Int?
  limiteSuperior  Int?
  luchadores      Luchador[]
  combates        Combate[]
  rankings        Ranking[]
  createdAt       DateTime    @default(now())
}

model Modalidad {
  id        String           @id @default(uuid())
  nombre    String           @unique
  records   RecordLuchador[]
  combates  Combate[]
  rankings  Ranking[]
  createdAt DateTime         @default(now())
}

model Luchador {
  id                String           @id @default(uuid())
  nombre            String
  apodo             String
  apellido          String
  edad              Int?
  altura            Int?
  ultimoPeso        Float?
  pais              String
  ciudad            String

  categoriaId       String
  categoria         CategoriaPeso    @relation(fields: [categoriaId], references: [id])

  equipoId          String
  equipo            Equipo           @relation(fields: [equipoId], references: [id])

  records             RecordLuchador[]
  combatesComoPel1    Combate[]        @relation("Peleador1Combates")
  combatesComoPel2    Combate[]        @relation("Peleador2Combates")
  combatesGanados     Combate[]        @relation("GanadorCombates")
  rankingItems        RankingItem[]
  rankingsComoChampion Ranking[]      @relation("CampeonRanking")

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model RecordLuchador {
  id          String    @id @default(uuid())
  luchadorId  String
  luchador    Luchador  @relation(fields: [luchadorId], references: [id], onDelete: Cascade)
  
  modalidadId String
  modalidad   Modalidad @relation(fields: [modalidadId], references: [id])
  
  victorias   Int       @default(0)
  derrotas    Int       @default(0)
  empates     Int       @default(0)

  @@unique([luchadorId, modalidadId])
}

enum EstadoEvento {
  BORRADOR
  PROGRAMADO
  CONFIRMADO
  FINALIZADO
  CANCELADO
}

enum TipoCombate {
  ESTELAR
  CO_ESTELAR
  CARTELERA_PRINCIPAL
  PRELIMINAR
}

enum EstadoCombate {
  CANCELADO
  PROGRAMADO
  CONFIRMADO
  FINALIZADO
}

model Evento {
  id          String       @id @default(uuid())
  numero      Int          @unique
  fecha       DateTime
  horaInicio  String
  horaFin     String
  lugarNombre String
  calle       String
  calleNumero String
  estado      EstadoEvento @default(PROGRAMADO)

  combates    Combate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Combate {
  id              String        @id @default(uuid())

  peleador1Id     String
  peleador1       Luchador      @relation("Peleador1Combates", fields: [peleador1Id], references: [id])

  peleador2Id     String
  peleador2       Luchador      @relation("Peleador2Combates", fields: [peleador2Id], references: [id])

  rounds          Int           @default(3)
  duracionRounds  Int           @default(5)

  eventoId        String
  evento          Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  tipo            TipoCombate   @default(PRELIMINAR)
  numeroPelea     Int           @default(1)
  horarioEstimado String?

  categoriaPesoId String
  categoriaPeso   CategoriaPeso @relation(fields: [categoriaPesoId], references: [id])

  modalidadId     String
  modalidad       Modalidad     @relation(fields: [modalidadId], references: [id])

  titulo          Boolean       @default(false)
  estado          EstadoCombate @default(PROGRAMADO)

  ganadorId       String?
  ganador         Luchador?     @relation("GanadorCombates", fields: [ganadorId], references: [id])

  viaVictoria     String?
  roundFin        Int?
  minutoFin       Int?
  segundoFin      Int?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Ranking {
  id              String         @id @default(uuid())
  categoriaPesoId String?
  categoriaPeso   CategoriaPeso? @relation(fields: [categoriaPesoId], references: [id], onDelete: Cascade)
  modalidadId     String
  modalidad       Modalidad      @relation(fields: [modalidadId], references: [id], onDelete: Cascade)
  items           RankingItem[]
  campeonId       String?
  campeon         Luchador?      @relation("CampeonRanking", fields: [campeonId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([categoriaPesoId, modalidadId])
}

model RankingItem {
  id         String   @id @default(uuid())
  rankingId  String
  ranking    Ranking  @relation(fields: [rankingId], references: [id], onDelete: Cascade)
  luchadorId String
  luchador   Luchador @relation(fields: [luchadorId], references: [id], onDelete: Cascade)
  posicion   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([rankingId, luchadorId])
  @@unique([rankingId, posicion])
}

enum EstadoOpinion {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum CategoriaOpinion {
  WEB_PLATAFORMA
  ORGANIZACION
  LUGAR_INSTALACIONES
  KIT_PREMIACION
  GENERAL
}

enum RolParticipante {
  ATLETA
  ESPECTADOR
  COACH
  OTRO
}

enum TipoOpinion {
  COMENTARIO
  SUGERENCIA
}

model Opinion {
  id              String           @id @default(uuid())

  nombreUsuario   String           @default("Anónimo")
  rolParticipante RolParticipante  @default(OTRO)

  tipo            TipoOpinion      @default(COMENTARIO)
  titulo          String
  descripcion     String
  categoria       CategoriaOpinion @default(GENERAL)

  estrellas       Int?

  estado          EstadoOpinion    @default(PENDIENTE)

  ipHash          String

  respuesta       RespuestaOficial?

  votos           VotoOpinion[]
  conteoVotos     Int              @default(0)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([estado, createdAt])
  @@index([categoria, estado])
  @@index([tipo, estado, conteoVotos])
}

model ValoracionAspecto {
  id         String           @id @default(uuid())
  ipHash     String
  categoria  CategoriaOpinion
  estrellas  Int              // 1-5

  createdAt  DateTime         @default(now())

  @@index([categoria])
}

model IndiceImpactoNPS {
  id               String   @id @default(uuid())
  nps              Int      // 0-10
  intencionRetorno Int      // 1-5
  satisfaccionWeb  Int      // 1-5
  ipHash           String

  createdAt        DateTime @default(now())

  @@index([createdAt])
}

model RespuestaOficial {
  id        String   @id @default(uuid())
  opinionId String   @unique
  opinion   Opinion  @relation(fields: [opinionId], references: [id], onDelete: Cascade)

  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  contenido String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VotoOpinion {
  id        String   @id @default(uuid())
  opinionId String
  opinion   Opinion  @relation(fields: [opinionId], references: [id], onDelete: Cascade)
  ipHash    String

  createdAt DateTime @default(now())

  @@unique([opinionId, ipHash])
}

