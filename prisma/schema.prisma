generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  SUPERADMIN
  ADMIN
  AYUDANTE
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(AYUDANTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipo {
  id         String     @id @default(uuid())
  nombre     String     @unique
  pais       String     @default("Desconocido")
  ciudad     String     @default("Desconocida")
  luchadores Luchador[]
  createdAt  DateTime   @default(now())
}

model CategoriaPeso {
  id              String      @id @default(uuid())
  nombre          String      @unique
  orden           Int         @default(0)
  limiteInferior  Int?
  limiteSuperior  Int?
  luchadores      Luchador[]
  combates        Combate[]
  createdAt       DateTime    @default(now())
}

model Modalidad {
  id        String           @id @default(uuid())
  nombre    String           @unique
  records   RecordLuchador[]
  combates  Combate[]
  createdAt DateTime         @default(now())
}

model Luchador {
  id                String           @id @default(uuid())
  nombre            String
  apodo             String
  apellido          String
  edad              Int?
  altura            Int?
  ultimoPeso        Float?
  pais              String
  ciudad            String

  categoriaId       String
  categoria         CategoriaPeso    @relation(fields: [categoriaId], references: [id])

  equipoId          String
  equipo            Equipo           @relation(fields: [equipoId], references: [id])

  records           RecordLuchador[]
  combatesComoPel1  Combate[]        @relation("Peleador1Combates")
  combatesComoPel2  Combate[]        @relation("Peleador2Combates")
  combatesGanados   Combate[]        @relation("GanadorCombates")

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model RecordLuchador {
  id          String    @id @default(uuid())
  luchadorId  String
  luchador    Luchador  @relation(fields: [luchadorId], references: [id], onDelete: Cascade)
  
  modalidadId String
  modalidad   Modalidad @relation(fields: [modalidadId], references: [id])
  
  victorias   Int       @default(0)
  derrotas    Int       @default(0)
  empates     Int       @default(0)

  @@unique([luchadorId, modalidadId])
}

enum EstadoEvento {
  BORRADOR
  PROGRAMADO
  CONFIRMADO
  FINALIZADO
  CANCELADO
}

enum TipoCombate {
  ESTELAR
  CO_ESTELAR
  CARTELERA_PRINCIPAL
  PRELIMINAR
}

enum EstadoCombate {
  CANCELADO
  PROGRAMADO
  CONFIRMADO
  FINALIZADO
}

model Evento {
  id          String       @id @default(uuid())
  numero      Int          @unique
  fecha       DateTime
  horaInicio  String
  horaFin     String
  lugarNombre String
  calle       String
  calleNumero String
  estado      EstadoEvento @default(PROGRAMADO)

  combates    Combate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Combate {
  id              String        @id @default(uuid())

  peleador1Id     String
  peleador1       Luchador      @relation("Peleador1Combates", fields: [peleador1Id], references: [id])

  peleador2Id     String
  peleador2       Luchador      @relation("Peleador2Combates", fields: [peleador2Id], references: [id])

  rounds          Int           @default(3)
  duracionRounds  Int           @default(5)

  eventoId        String
  evento          Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  tipo            TipoCombate   @default(PRELIMINAR)
  numeroPelea     Int           @default(1)
  horarioEstimado String?

  categoriaPesoId String
  categoriaPeso   CategoriaPeso @relation(fields: [categoriaPesoId], references: [id])

  modalidadId     String
  modalidad       Modalidad     @relation(fields: [modalidadId], references: [id])

  titulo          Boolean       @default(false)
  estado          EstadoCombate @default(PROGRAMADO)

  ganadorId       String?
  ganador         Luchador?     @relation("GanadorCombates", fields: [ganadorId], references: [id])

  viaVictoria     String?
  roundFin        Int?
  minutoFin       Int?
  segundoFin      Int?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
