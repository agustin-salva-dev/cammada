generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  SUPERADMIN
  ADMIN
  AYUDANTE
}

model Usuario {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(AYUDANTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Equipo {
  id         String     @id @default(uuid())
  nombre     String     @unique
  pais       String     @default("Desconocido")
  ciudad     String     @default("Desconocida")
  luchadores Luchador[]
  createdAt  DateTime   @default(now())
}

model CategoriaPeso {
  id              String     @id @default(uuid())
  nombre          String     @unique
  orden           Int        @default(0)
  limiteInferior  Int?
  limiteSuperior  Int?
  luchadores      Luchador[]
  createdAt       DateTime   @default(now())
}

model Modalidad {
  id        String           @id @default(uuid())
  nombre    String           @unique
  records   RecordLuchador[]
  createdAt DateTime         @default(now())
}

model Luchador {
  id           String          @id @default(uuid())
  nombre       String
  apodo        String
  apellido     String
  edad         Int?
  altura       Int?
  ultimoPeso   Float?
  pais         String
  ciudad       String
  
  categoriaId  String
  categoria    CategoriaPeso   @relation(fields: [categoriaId], references: [id])
  
  equipoId     String
  equipo       Equipo          @relation(fields: [equipoId], references: [id])
  
  records      RecordLuchador[]
  
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model RecordLuchador {
  id          String    @id @default(uuid())
  luchadorId  String
  luchador    Luchador  @relation(fields: [luchadorId], references: [id], onDelete: Cascade)
  
  modalidadId String
  modalidad   Modalidad @relation(fields: [modalidadId], references: [id])
  
  victorias   Int       @default(0)
  derrotas    Int       @default(0)
  empates     Int       @default(0)

  @@unique([luchadorId, modalidadId])
}

enum EstadoEvento {
  BORRADOR
  PROGRAMADO
  CONFIRMADO
  FINALIZADO
  CANCELADO
}

model Evento {
  id          String       @id @default(uuid())
  numero      Int          @unique
  fecha       DateTime
  horaInicio  String
  horaFin     String
  lugarNombre String
  calle       String
  calleNumero String
  estado      EstadoEvento @default(PROGRAMADO)

  // Relación futura con peleas:
  // peleas Pelea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
